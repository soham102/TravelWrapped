# ── Required for real accounts & cloud data (otherwise the app runs in "local mode") ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of the deployment (used for share links, OG images, invite emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional ──
# Sign-in is "Continue with Google" whenever Supabase is configured.
# Enable it in Supabase → Authentication → Sign In / Providers → Google (see README).

# Server-side invitation emails via Resend (without it: invitations are recorded + mailto fallback)
RESEND_API_KEY=
INVITE_FROM_EMAIL="Travel Wrapped <invites@yourdomain.com>"

# Admin analytics at /admin (server-only; never expose the service role key to the browser)
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=you@example.com

# Destination search: Photon/OpenStreetMap is used by default (free, keyless). Set GEOCODER=off to use only the curated list.
GEOCODER=
GEOCODER_URL=

# Map tiles for the interactive map (defaults to keyless Esri dark-gray basemap)
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_TILES_ATTRIBUTION=
